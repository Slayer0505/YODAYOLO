# ==============================================================================
# YODA — Persistent Cognitive Operating System
# Environment Configuration Template
# Copy this file to .env and adjust as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# HTTP port to listen on (default: 8080)
PORT=8080

# Host address to bind to (default: 127.0.0.1)
HOST=127.0.0.1

# Path to the local SQLite state database (default: yoda_l0.db)
# This database stores the L0 Event Ledger, L1 Experiences, L2 Knowledge Rules,
# L4 Meta-learning predictions, Sessions, and Heart supervisory logs.
DB_PATH=yoda_l0.db

# ------------------------------------------------------------------------------
# REASONING PROVIDER CONFIGURATION (INTERCHANGEABLE BACKEND)
# ------------------------------------------------------------------------------
# Provider Type to use for LLM reasoning:
#   auto     - Auto-detect live Ollama at UPSTREAM_URL, fallback to mock (default)
#   mock     - Deterministic local mock engine (no external API calls required)
#   ollama   - Local Ollama instance (e.g. http://127.0.0.1:11434)
#   upstream - Custom OpenAI-compatible HTTP endpoint
PROVIDER_TYPE=auto

# Default reasoning model name or alias
# e.g., neutral-reasoner, gpt-4o, claude-3-5-sonnet, deepseek-chat, qwen2.5:3b
DEFAULT_MODEL=neutral-reasoner

# Upstream endpoint URL (used when PROVIDER_TYPE is 'ollama' or 'upstream')
UPSTREAM_URL=http://127.0.0.1:11434

# Upstream API Key (optional, for authenticated third-party proxies)
# UPSTREAM_KEY=your-api-key-here

# ------------------------------------------------------------------------------
# CODEBASE CORTEX (GRAFT INTEGRATION)
# ------------------------------------------------------------------------------
# Optional path to Graft repository or CLI (if external Graft installation exists)
# If omitted, YODA automatically indexes the local workspace symbol graph natively.
# GRAFT_PATH=/path/to/graft
