# ==============================================================================
# YODA — Persistent Cognitive Operating System Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=127.0.0.1

# SQLite Storage Path (Defaults to local yoda_l0.db)
DB_PATH=yoda_l0.db

# Default Reasoning Engine / Model (Explicit client requests remain authoritative)
DEFAULT_MODEL=neutral-reasoner

# Optional Cloud Model Provider API Keys (Leave blank if using local models or client-managed auth)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Upstream / Ollama Endpoint Configuration
# UPSTREAM_URL=http://127.0.0.1:11434
# UPSTREAM_KEY=
